# 首次启动时创建管理员账号；数据库已有该用户名时保留数据库中的密码哈希
CLIPMESH_ADMIN_USERNAME=admin
CLIPMESH_ADMIN_PASSWORD=replace-with-a-long-password

# 反向代理已启用 HTTPS 后改为 true；本地 HTTP 预览保持 false
CLIPMESH_COOKIE_SECURE=false
CLIPMESH_SESSION_TTL=168h

# GitHub Container Registry 镜像
CLIPMESH_IMAGE=ghcr.io/alumos/clipmesh:latest

# NAS 对外暴露端口
CLIPMESH_PORT=8080
TZ=Asia/Shanghai

# 每个账号保留最近多少条文本剪贴板
CLIPMESH_TEXT_LIMIT=100

# 文件临时保存时长；Go duration，例如 12h、168h
CLIPMESH_FILE_TTL=24h
CLIPMESH_CLEANUP_INTERVAL=1h
CLIPMESH_MAX_UPLOAD_SIZE=100MB

# 只有前后端跨域部署时才填写精确来源，多个来源用逗号分隔
CLIPMESH_CORS_ORIGINS=
